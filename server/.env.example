# Copy to server/.env and edit. Both values below are the defaults, so an
# empty or missing .env runs exactly as before.
#
# Real environment variables take priority over this file, so a host that
# injects PORT wins without any change here.

# Port the Fastify + Socket.IO server listens on.
PORT=3001

# Comma-separated CORS allowlist for the client, used by both Fastify and
# Socket.IO. Vite takes the first free port from 5173, so both are listed.
# Add your deployed client origin here before going live.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
